# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection
# Replace with your MongoDB Atlas or local connection string:
# e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/flexora
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/flexora

# Authentication & JWT Secrets
JWT_SECRET=replace_with_a_cryptographically_secure_random_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_cryptographically_secure_refresh_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie Security (used in production for HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Password Reset Token Settings
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1

# Email Service Configuration (Dev mode prints reset link to console)
EMAIL_SERVICE_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@flexora.com

# Initial Platform Admin Bootstrap / Seed Credentials
ADMIN_SEED_EMAIL=admin@flexora.com
ADMIN_SEED_PASSWORD=Admin@123456
OWNER_SEED_EMAIL=owner@flexora.com
OWNER_SEED_PASSWORD=Owner@123456
MANAGER_SEED_EMAIL=manager@flexora.com
MANAGER_SEED_PASSWORD=Manager@123456
STAFF_SEED_EMAIL=staff@flexora.com
STAFF_SEED_PASSWORD=Staff@123456
